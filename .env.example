# =============================================================================
# Beauty Platform — environment template
# Copy to apps/api/.env and apps/web/.env.local as needed.
# NEVER commit real secrets.
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://beauty:beauty@localhost:5432/beauty_platform?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED="true"

# --- API ---
NODE_ENV="development"
API_PORT="4000"
API_HOST="0.0.0.0"
PUBLIC_API_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# --- Auth ---
AUTH_SECRET="replace-with-a-64-character-random-string-in-production"
AUTH_COOKIE_NAME="bp_session"
AUTH_ACCESS_TTL="15m"
AUTH_REFRESH_TTL="7d"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_DOMAIN=""

# --- Email (optional in development — logs to console if unset) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Noir Atelier <noreply@example.com>"

# --- Image storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
IMAGE_MAX_BYTES="5242880"
IMAGE_MAX_WIDTH="4096"
IMAGE_MAX_HEIGHT="4096"

# --- WhatsApp ---
WHATSAPP_COUNTRY_CODE="233"
WHATSAPP_CLICK_TO_CHAT_BASE="https://wa.me"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Noir Atelier"

# --- Admin seed (development only) ---
SEED_ADMIN_EMAIL="admin@noir-atelier.dev"
SEED_ADMIN_PASSWORD="ChangeMe_Admin_123!"
