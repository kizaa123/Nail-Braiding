{
  "name": "@beauty/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --entryFile apps/api/src/main",
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "start:prod": "node dist/apps/api/src/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate --schema ../../database/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema ../../database/prisma/schema.prisma --skip-generate",
    "prisma:migrate": "prisma migrate deploy --schema ../../database/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ../../database/prisma/schema.prisma",
    "prisma:seed": "tsx ../../database/prisma/seed.ts",
    "prisma:studio": "prisma studio --schema ../../database/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../../database/prisma/schema.prisma",
    "seed": "tsx ../../database/prisma/seed.ts"
  },
  "dependencies": {
    "@beauty/config": "0.1.0",
    "@beauty/types": "0.1.0",
    "@beauty/validation": "0.1.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.9.0",
    "argon2": "^0.43.0",
    "cloudinary": "^2.6.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "multer": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
